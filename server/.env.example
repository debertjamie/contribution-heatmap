# GitHub Personal Access Token (read:user scope). Required — no default.
GITHUB_TOKEN=
# Port the backend listens on.
PORT=3001
# Comma-separated list of allowed CORS origins (the frontend URL(s)).
ALLOWED_ORIGINS=http://localhost:5173
# Rate-limit window in milliseconds for /api/contributions/*.
RATE_LIMIT_WINDOW_MS=60000
# Max requests per IP per window for /api/contributions/*.
RATE_LIMIT_MAX=30
# In-memory cache TTL in milliseconds (per username:year).
CACHE_TTL_MS=600000
